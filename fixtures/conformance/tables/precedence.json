      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "y",
              "type": "number"
            },
            {
              "name": "z",
              "type": "string"
            }
          ]
        }
      },
      "expected": {
        "issue": {
          "code": "E5004",
          "message": "Invalid quoting in the CSV text at byte 14.",
          "offset": 14
        }
      }
    },
