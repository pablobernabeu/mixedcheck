{
  "description": "Nested grouping factors written with '/' or ':', their names and order, and the design matrices of a nested design.",
  "cases": [
    {
      "id": "nested-01",
      "description": "'/' in a grouping factor gives a term for the outer factor and one for the interaction.",
      "formula": "y ~ 1 + (1 | school/class)",
      "data": {"y": [1, 2, 3, 4], "school": ["S1", "S1", "S2", "S2"], "class": ["1", "2", "1", "2"]},
      "expected": {
        "ir": {
          "ir_version": "0.1.0",
          "predictors": {},
          "fixed": {
            "terms": [{"name": "(Intercept)", "variables": []}],
            "columns": [{"name": "(Intercept)", "term": 0, "levels": {}}]
          },
          "random": [
            {
              "name": "1 | school",
              "factor": "school",
              "grouping": ["school"],
              "covariance": "unstructured",
              "terms": [{"name": "(Intercept)", "variables": []}],
              "columns": [{"name": "(Intercept)", "term": 0, "levels": {}}]
            },
            {
              "name": "1 | school:class",
              "factor": "school:class",
              "grouping": ["school", "class"],
              "covariance": "unstructured",
              "terms": [{"name": "(Intercept)", "variables": []}],
              "columns": [{"name": "(Intercept)", "term": 0, "levels": {}}]
            }
          ],
          "offsets": [],
          "response": {"variable": "y", "transform": "identity"}
        },
        "ir_hash": "sha256:54afc3debff83d194e2e589eb697c2894d5122523c7bbebc950b9cdf792a1e77"
      }
    },
