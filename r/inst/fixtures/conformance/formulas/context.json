{
  "description": "Errors that need the data, the declaration or the coding argument, and the order in which they are reported.",
  "cases": [
    {
      "id": "context-01",
      "description": "A column that is not in the data.",
      "formula": "y ~ x + age",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "expected": {
        "issue": {
          "code": "E6051",
          "message": "The column 'age' at byte 8 is not in the data, or in the declared table when there are no data.",
          "offset": 8
        }
      }
    },
    {
      "id": "context-02",
      "description": "Without data, a column must be declared in the table block.",
      "formula": "y ~ x + age",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {"fields": [{"name": "y", "type": "number"}, {"name": "x", "type": "number"}]}
      },
      "expected": {
        "issue": {
          "code": "E6051",
          "message": "The column 'age' at byte 8 is not in the data, or in the declared table when there are no data.",
          "offset": 8
        }
      }
    },
    {
      "id": "context-03",
      "description": "A declared date column cannot be a predictor.",
      "formula": "y ~ day",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {"fields": [{"name": "y", "type": "number"}, {"name": "day", "type": "date"}]}
      },
      "data": {"y": [1, 2], "day": ["2026-11-01", "2026-11-02"]},
      "expected": {
        "issue": {
          "code": "E6052",
          "message": "The column 'day' at byte 4 has the kind 'date', which cannot be used as a predictor.",
          "offset": 4
        }
      }
    },
    {
      "id": "context-04",
      "description": "log() needs a numeric response.",
      "formula": "log(cond) ~ x",
      "data": {"cond": ["a", "b"], "x": [1, 2]},
      "expected": {
        "issue": {
          "code": "E6052",
          "message": "The column 'cond' at byte 4 has the kind 'categorical', which cannot be used as the argument of log().",
          "offset": 4
        }
      }
    },
    {
      "id": "context-05",
      "description": "A response with declared trials cannot be written with log().",
      "formula": "log(k) ~ x",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {"name": "k", "type": "integer"},
            {"name": "n", "type": "integer"},
            {"name": "x", "type": "number"}
          ]
        },
        "variables": {"k": {"role": "outcome", "measurement": "binomial", "trials": "n"}}
      },
      "data": {"k": [1, 2], "n": [3, 3], "x": [1, 2]},
      "expected": {
        "issue": {
          "code": "E6054",
          "message": "The response at byte 0 has a declared 'trials', so it cannot be written with log().",
          "offset": 0
        }
      }
    },
    {
      "id": "context-06",
      "description": "Without data, the levels of an undeclared categorical column are unknown.",
      "formula": "y ~ cond",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {"fields": [{"name": "y", "type": "number"}, {"name": "cond", "type": "string"}]}
      },
      "expected": {
        "issue": {
          "code": "E6055",
          "message": "The levels of the categorical column 'cond' at byte 4 are neither declared nor found in the data.",
          "offset": 4
        }
      }
    },
    {
      "id": "context-07",
      "description": "A categorical predictor with one level cannot be coded.",
      "formula": "y ~ x + cond",
      "data": {"y": [1, 2], "x": [1, 2], "cond": ["A", "A"]},
      "expected": {
        "issue": {
          "code": "E6056",
          "message": "The categorical column 'cond' at byte 8 has fewer than two levels and cannot be coded.",
          "offset": 8
        }
      }
    },
    {
      "id": "context-08",
      "description": "The coding names a column that is not a predictor.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6],
        "z": [0.5, 0.25, 1.5, 2, 0.75, 1.25, 1, 0.5, 2.5, 1.75, 0.25, 3]
      },
      "coding": {"z": {"centring": "mean"}},
      "expected": {
        "issue": {
          "code": "E6061",
          "message": "The coding names the column 'z', which is not a predictor of the formula."
        }
      }
    },
    {
      "id": "context-09",
      "description": "A contrast for a numeric column.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"contrast": "sum"}},
      "expected": {
        "issue": {
          "code": "E6062",
          "message": "The coding of the column 'x' sets 'contrast', which does not apply to a column of its kind."
        }
      }
    },
    {
      "id": "context-10",
      "description": "A contrast that is not in IR 0.1.",
      "formula": "y ~ a",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "a": ["A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3"]
      },
      "coding": {"a": {"contrast": "helmert"}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'a' has an unknown member, an invalid value or a missing value at 'contrast'."
        }
      }
    },
    {
      "id": "context-11",
      "description": "A reference level that is not a level.",
      "formula": "y ~ a",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "a": ["A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3"]
      },
      "coding": {"a": {"reference": "A4"}},
      "expected": {
        "issue": {
          "code": "E6064",
          "message": "The reference level 'A4' of the column 'a' is not one of its levels."
        }
      }
    },
    {
      "id": "context-12",
      "description": "An integer reference for a column of strings is not a level.",
      "formula": "y ~ a",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "a": ["A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3"]
      },
      "coding": {"a": {"reference": 1}},
      "expected": {
        "issue": {
          "code": "E6064",
          "message": "The reference level 1 of the column 'a' is not one of its levels."
        }
      }
    },
    {
      "id": "context-13",
      "description": "Significant digits apply only to mean centring.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"significant_digits": 3}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'x' has an unknown member, an invalid value or a missing value at 'significant_digits'."
        }
      }
    },
    {
      "id": "context-14",
      "description": "Centring at a value needs the value.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"centring": "value"}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'x' has an unknown member, an invalid value or a missing value at 'centring'."
        }
      }
    },
    {
      "id": "context-15",
      "description": "A centring value must be a decimal string.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"centring": "value", "value": "1e3"}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'x' has an unknown member, an invalid value or a missing value at 'value'."
        }
      }
    },
    {
      "id": "context-16",
      "description": "The declared trials column is not in the data.",
      "formula": "k ~ x",
      "declaration": {
        "vocabulary": "0.1.0",
        "variables": {"k": {"role": "outcome", "measurement": "binomial", "trials": "n"}}
      },
      "data": {"k": [1, 2], "x": [1, 2]},
      "expected": {
        "issue": {
          "code": "E6065",
          "message": "The column 'n', declared as the trials of the response, is not a numeric column of the data or the declaration."
        }
      }
    },
    {
      "id": "context-17",
      "description": "The weights column must be numeric.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6],
        "a": ["A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3"]
      },
      "weights": "a",
      "expected": {
        "issue": {
          "code": "E6066",
          "message": "The weights column 'a' is not a numeric column of the data or the declaration."
        }
      }
    },
    {
      "id": "context-18",
      "description": "Mean centring on an empty design sample.",
      "formula": "y ~ x + z",
      "data": {"y": [1, 2], "x": [1, null], "z": [null, 2]},
      "coding": {"x": {"centring": "mean"}},
      "expected": {
        "issue": {
          "code": "E6067",
          "message": "The design sample has no rows, so the centring constant of 'x' cannot be computed."
        }
      }
    },
    {
      "id": "context-19",
      "description": "Two columns of the fixed part with the same name: the numeric column 'a[A2]' and the column of level A2 of 'a'.",
      "formula": "y ~ a + `a[A2]`",
      "data": {"y": [1, 2], "a": ["A1", "A2"], "a[A2]": [0.5, 1.5]},
      "expected": {
        "issue": {"code": "E6059", "message": "Two columns of one part of the model are both named 'a[A2]'."}
      }
    },
    {
      "id": "context-20",
      "description": "An unknown column is reported before a coding problem.",
      "formula": "y ~ x + age",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"contrast": "sum"}},
      "expected": {
        "issue": {
          "code": "E6051",
          "message": "The column 'age' at byte 8 is not in the data, or in the declared table when there are no data.",
          "offset": 8
        }
      }
    },
    {
      "id": "context-21",
      "description": "Among the issues of one pass, the first by offset is reported: 'cond' at byte 4 comes before 'day' at byte 16.",
      "formula": "log(cond) ~ x + day",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {"name": "cond", "type": "string"},
            {"name": "x", "type": "number"},
            {"name": "day", "type": "date"}
          ]
        }
      },
      "expected": {
        "issue": {
          "code": "E6052",
          "message": "The column 'cond' at byte 4 has the kind 'categorical', which cannot be used as the argument of log().",
          "offset": 4
        }
      }
    },
    {
      "id": "context-22",
      "description": "A coding value is checked before its kind: an invalid contrast for a numeric column is reported as an invalid value.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"contrast": "poly"}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'x' has an unknown member, an invalid value or a missing value at 'contrast'."
        }
      }
    },
    {
      "id": "context-23",
      "description": "Within one entry of the coding, every member is checked for its name and value before any is checked against the kind: 'zzz' is reported, not 'contrast'.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"contrast": "sum", "zzz": 1}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'x' has an unknown member, an invalid value or a missing value at 'zzz'."
        }
      }
    },
    {
      "id": "context-24",
      "description": "Entries of the coding are checked one at a time in code-point order of their keys, so the invalid member of 'a' is reported before the unknown column 'z'.",
      "formula": "y ~ a",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "a": ["A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3"]
      },
      "coding": {"a": {"bad": 1}, "z": {}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'a' has an unknown member, an invalid value or a missing value at 'bad'."
        }
      }
    },
    {
      "id": "context-25",
      "description": "Freezing applies only to categorical predictors.",
      "formula": "y ~ x",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6]
      },
      "coding": {"x": {"frozen": true}},
      "expected": {
        "issue": {
          "code": "E6062",
          "message": "The coding of the column 'x' sets 'frozen', which does not apply to a column of its kind."
        }
      }
    },
    {
      "id": "context-26",
      "description": "'frozen' takes a boolean.",
      "formula": "y ~ a",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "a": ["A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3", "A1", "A2", "A3"]
      },
      "coding": {"a": {"frozen": "yes"}},
      "expected": {
        "issue": {
          "code": "E6063",
          "message": "The coding of the column 'a' has an unknown member, an invalid value or a missing value at 'frozen'."
        }
      }
    },
    {
      "id": "context-27",
      "description": "The label column of the participant unit cannot be a predictor.",
      "formula": "y ~ subject + x",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {"name": "y", "type": "number"},
            {"name": "x", "type": "number"},
            {"name": "subject", "type": "string"}
          ]
        },
        "units": [{"name": "subject", "columns": ["subject"], "role": "participant"}]
      },
      "data": {"y": [1, 2, 3, 4], "x": [0.5, 1.5, 2.5, 3.5], "subject": ["s1", "s1", "s2", "s2"]},
      "expected": {
        "issue": {
          "code": "E6068",
          "message": "The column 'subject' at byte 4 identifies persons and cannot be a predictor. Use it to group a random term.",
          "offset": 4
        }
      }
    },
    {
      "id": "context-28",
      "description": "A column with the role 'id' cannot be a predictor of a random term either.",
      "formula": "y ~ x + (1 + pid | g)",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {"name": "y", "type": "number"},
            {"name": "x", "type": "number"},
            {"name": "pid", "type": "string"},
            {"name": "g", "type": "string"}
