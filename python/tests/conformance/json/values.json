{
  "description": "Inputs that the strict reader refuses in stage 4, when it checks keys, strings and null in the order of the input, with the precedence of syntax errors over value errors.",
  "cases": [
    {
      "id": "json-values-001",
      "description": "A duplicate key.",
      "input": "{\"a\":1,\"a\":2}",
      "expected": {
        "plain": {
          "issue": {
            "code": "E1029",
            "message": "Duplicate key 'a' at byte 7.",
            "offset": 7
          }
        },
        "data": {
          "issue": {
            "code": "E1029",
            "message": "Duplicate key 'a' at byte 7.",
            "offset": 7
          }
        },
        "hashable": {
          "issue": {
            "code": "E1029",
            "message": "Duplicate key 'a' at byte 7.",
            "offset": 7
          }
        }
      }
    },
    {
      "id": "json-values-002",
      "description": "A duplicate key written with an escape.",
      "input": "{\"a\":1,\"\\u0061\":2}",
      "expected": {
        "plain": {
          "issue": {
            "code": "E1029",
            "message": "Duplicate key 'a' at byte 7.",
            "offset": 7
          }
        },
