    {
      "id": "audits-keys-009",
      "description": "An observation key that includes an outcome-derived column is refused with E6069 before any check.",
      "checks": ["keys.duplicates"],
      "data": {
        "y": [1, 2, 3, 4],
        "x": [1, 2, 3, 4],
        "subject": ["s1", "s1", "s2", "s2"],
        "lag": [0, 1, 0, 2]
      },
      "formula": "y ~ x + (1 | subject)",
      "declaration": {
        "vocabulary": "0.1.0",
        "observation": {"key": ["subject", "lag"]},
        "variables": {"lag": {"role": "outcome_derived"}}
      },
      "expected": {
        "issue": {"code": "E6069", "message": "The column 'lag' is an outcome, is derived from one or holds the trials of the response, so the outcome-blind checks cannot read it."}
      }
