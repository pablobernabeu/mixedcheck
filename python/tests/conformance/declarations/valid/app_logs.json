{
  "vocabulary": "0.1.0",
  "title": "Reading app event logs",
  "features": ["intensive_longitudinal", "trial_level"],
  "units": [
    {"name": "child", "columns": ["child"], "role": "participant"},
    {
      "name": "session",
      "columns": ["session"],
      "nested_in": "child",
      "id_scope": "within_parent",
      "role": "session"
    }
  ],
  "observation": {
    "key": ["child", "event_id"],
    "time": {"column": "ts", "kind": "timestamp", "within": "child"}
  },
  "variables": {
    "correct": {"role": "outcome", "measurement": "binary", "event_level": 1},
    "prev_correct": {"role": "outcome_derived", "derived_from": ["correct"]},
    "age_months": {"role": "baseline_covariate", "measurement": "continuous"},
    "event_id": {"role": "id"},
    "ts": {"role": "time"}
  }
}
