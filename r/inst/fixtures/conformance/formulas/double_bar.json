    {
      "id": "double-bar-07",
      "description": "'||' cannot split a categorical column, whose indicators would duplicate the intercept.",
      "formula": "y ~ (1 + cond || g)",
      "data": {"y": [1, 2], "cond": ["A", "B"], "g": ["g1", "g2"]},
      "expected": {
        "issue": {
          "code": "E6053",
          "message": "The column 'cond' at byte 9 is categorical, and '||' splits only numeric terms. Use '|' for a random term with a categorical column.",
          "offset": 9
        }
      }
    },
    {
      "id": "double-bar-08",
      "description": "'||' is rejected when any term contains a categorical column.",
      "formula": "y ~ (1 + x:cond || g)",
      "data": {"y": [1, 2], "x": [1, 2], "cond": ["A", "B"], "g": ["g1", "g2"]},
      "expected": {
        "issue": {
          "code": "E6053",
