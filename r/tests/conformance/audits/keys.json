    {
      "id": "audits-keys-013",
      "description": "A column of the observation key that the formula does not read, wave, is declared with the categories 1 and 2 and holds 3 in a data frame. audit() refuses it with E5012 at the pointer of the value, as the table reader refuses it in a file with E5007, since the rule on observation keys of the privacy filter counts a column with declared categories among those whose levels the declaration gives. The missing value of wave is not compared, and the value C of site, outside its categories too, lies in a later row.",
      "checks": ["keys.duplicates"],
      "data": {
        "y": [1, 2, 3, 4, 5, 6, 7, 8],
        "x": [1, 2, 1, 2, 1, 2, 1, 2],
        "subject": ["s1", "s1", "s2", "s2", "s3", "s3", "s4", "s4"],
        "wave": [1, 2, null, 2, 1, 3, 1, 2],
        "site": ["A", "A", "A", "A", "B", "B", "C", "B"]
      },
      "formula": "y ~ x + (1 | subject)",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {"name": "y", "type": "number"},
            {"name": "x", "type": "number"},
            {"name": "subject", "type": "string"},
            {"name": "wave", "type": "integer", "categories": [1, 2]},
            {"name": "site", "type": "string", "categories": ["A", "B"]}
          ]
        },
        "observation": {"key": ["subject", "wave"]}
      },
      "expected": {
        "issue": {"code": "E5012", "message": "The value of the column 'wave' at /data/wave/5 is not one of its declared categories.", "pointer": "/data/wave/5"}
      }
    }
  ]
