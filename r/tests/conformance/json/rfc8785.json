{
  "description": "The examples of RFC 8785: the canonicalised example of sections 3.2.2 and 3.2.4, the sorting example of section 3.2.3 and the number serialisations of appendix B.",
  "cases": [
    {
      "id": "json-rfc8785-001",
      "description": "RFC 8785, section 3.2.2. In the hashable profile, its first number has 17 significant digits.",
      "input": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50, 2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}",
      "expected": {
        "plain": {
          "canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"\u20ac$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
          "sha256": "sha256:2d5e01a318d0f0879ab568c4be289c8b1f64ef8921a53c6277d5e069978baacb"
        },
        "data": {
          "canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"\u20ac$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
          "sha256": "sha256:2d5e01a318d0f0879ab568c4be289c8b1f64ef8921a53c6277d5e069978baacb"
        },
        "hashable": {
          "issue": {
            "code": "E1103",
            "message": "The number 333333333.33333329 at byte 16 has more than 15 significant digits.",
            "offset": 16
          }
        }
      }
    },
    {
      "id": "json-rfc8785-002",
      "description": "RFC 8785, section 3.2.3: members sorted by the UTF-16 code units of their keys, so that the key U+1F600 comes before U+FB33. The profiles refuse the key outside the BMP and the hashable profile, first, the key U+FB33, whose NFC form is U+05D3 U+05BC.",
      "input": "{\n  \"\\u20ac\": \"Euro Sign\",\n  \"\\r\": \"Carriage Return\",\n  \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n  \"1\": \"One\",\n  \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n  \"\\u0080\": \"Control\",\n  \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}",
      "expected": {
        "plain": {
          "canonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}",
          "sha256": "sha256:5e321556d22018a9656991a9e94f77ec175fa193e52a2429d312f8419ec8b08c"
        },
        "data": {
          "issue": {
            "code": "E1108",
            "message": "The key at byte 117 contains a character outside the Basic Multilingual Plane.",
            "offset": 117
          }
        },
        "hashable": {
          "issue": {
            "code": "E1203",
            "message": "The string at byte 56 is not in Unicode normalisation form C (NFC).",
            "offset": 56
          }
        }
      }
    },
