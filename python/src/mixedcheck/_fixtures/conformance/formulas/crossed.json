          },
          "fixed": {
            "terms": [
              {"name": "(Intercept)", "variables": []},
              {"name": "cond", "variables": [{"variable": "cond", "coding": "contrast"}]}
            ],
            "columns": [
              {"name": "(Intercept)", "term": 0, "levels": {}},
              {"name": "cond[B]", "term": 1, "levels": {"cond": "B"}}
            ]
          },
          "random": [
            {
              "name": "1 + cond | subject",
              "factor": "subject",
              "grouping": ["subject"],
              "covariance": "unstructured",
              "terms": [
                {"name": "(Intercept)", "variables": []},
                {"name": "cond", "variables": [{"variable": "cond", "coding": "contrast"}]}
              ],
              "columns": [
                {"name": "(Intercept)", "term": 0, "levels": {}},
                {"name": "cond[B]", "term": 1, "levels": {"cond": "B"}}
              ]
            },
            {
              "name": "1 + cond | item",
              "factor": "item",
              "grouping": ["item"],
              "covariance": "unstructured",
              "terms": [
                {"name": "(Intercept)", "variables": []},
                {"name": "cond", "variables": [{"variable": "cond", "coding": "contrast"}]}
              ],
              "columns": [
                {"name": "(Intercept)", "term": 0, "levels": {}},
                {"name": "cond[B]", "term": 1, "levels": {"cond": "B"}}
              ]
            }
          ],
          "offsets": [],
          "response": {"variable": "rt", "transform": "identity"}
        },
        "ir_hash": "sha256:fb5ac0b0dd0e1f589538882560088a2481c872a8bf065660c0c40ca1f7e6db7a"
      }
