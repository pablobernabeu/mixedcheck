{
  "description": "Tables with several problems, of which the reader reports the first.",
  "cases": [
    {
      "id": "tables-precedence-001",
      "description": "A value error in an earlier record before a record of the wrong length.",
      "path": "precedence/earlier_record_first.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "y",
              "type": "number"
            }
          ]
        }
      },
      "expected": {
        "issue": {
          "code": "E5006",
          "message": "The value 'x' of the column 'y' at byte 7 cannot be read as a number.",
          "offset": 7
        }
      }
    },
    {
      "id": "tables-precedence-002",
