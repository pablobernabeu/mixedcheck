        "pid": ["p1", "p2", "p3", "p4"],
        "g": ["g1", "g1", "g2", "g2"]
      },
      "expected": {
        "issue": {
          "code": "E6068",
          "message": "The column 'pid' at byte 13 identifies persons and cannot be a predictor. Use it to group a random term.",
          "offset": 13
        }
      }
    },
