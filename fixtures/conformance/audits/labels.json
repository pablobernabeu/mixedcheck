{
  "description": "Cases of labels.unicode_forms: the columns that hold labels and the spellings that NFC merges.",
  "cases": [
    {
      "id": "audits-labels-001",
      "description": "A precomposed and a decomposed spelling of one label in a grouping column: 2 distinct spellings treated as 1 label, merged.",
      "checks": ["labels.unicode_forms"],
      "data": {
        "y": [1, 2, 3, 4, 5, 6],
        "subject": ["Jos\u00e9", "Jos\u00e9", "Jose\u0301", "Ana", "Ana", "Bo"]
      },
      "formula": "y ~ 1 + (1 | subject)",
      "expected": {
        "findings": [
          {
            "check": "labels.unicode_forms",
            "check_version": 1,
            "tier": "T0",
            "scope": {"column": "subject"},
            "status": {"availability": {"value": "available"}, "assessability": {"value": "adequate"}, "finding": {"value": "detectable_inconsequential"}, "threshold_proximity": {"value": "clear"}, "validation": {"value": "descriptive"}},
            "message": {"id": "merged", "text": "In 'subject', 2 distinct spellings that differ only in their Unicode form are treated as 1 label."},
            "statistics": {
              "labels": {"kind": "count", "value": 1, "count_class": "person"},
              "spellings": {"kind": "count", "value": 2, "count_class": "person"}
            },
            "support": {"rows": {"value": 6}, "contributors": {"basis": "grouping_factors", "distinct": {"value": 3}, "dominated": false}}
          }
        ]
      }
    },
