            "check": "keys.duplicates",
            "check_version": 1,
            "tier": "T0",
            "scope": {},
            "status": {"availability": {"value": "available"}, "assessability": {"value": "adequate"}, "finding": {"value": "consistent"}, "threshold_proximity": {"value": "clear"}, "validation": {"value": "descriptive"}},
            "message": {"id": "unique", "text": "Every row has its own value of the observation key 'subject' and 'trial'."},
            "statistics": {
              "conflicting_keys": {"kind": "count", "value": 0, "count_class": "person"},
              "duplicate_rows": {"kind": "count", "value": 0, "count_class": "person"},
              "duplicated_keys": {"kind": "count", "value": 0, "count_class": "person"},
              "identical_keys": {"kind": "count", "value": 0, "count_class": "person"},
              "key_columns": {"kind": "names", "value": ["subject", "trial"]},
              "missing_key_rows": {"kind": "count", "value": 0, "count_class": "person"},
              "rows": {"kind": "count", "value": 6, "count_class": "person"}
