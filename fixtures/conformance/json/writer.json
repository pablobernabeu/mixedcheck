          "canonical": "[1,100,100,-5]",
          "sha256": "sha256:b57bfd344229ebcec696c3f1309f29fa6fbd6732dad2b370257d9b970a3c1461"
        },
        "data": {
          "canonical": "[1,100,100,-5]",
          "sha256": "sha256:b57bfd344229ebcec696c3f1309f29fa6fbd6732dad2b370257d9b970a3c1461"
        },
        "hashable": {
          "canonical": "[1,100,100,-5]",
          "sha256": "sha256:b57bfd344229ebcec696c3f1309f29fa6fbd6732dad2b370257d9b970a3c1461"
        }
      }
    },
    {
