{
  "description": "The primary key (E5008 and E5009) and the unique keys (E5010) of the table block.",
  "cases": [
    {
      "id": "tables-keys-001",
      "description": "A primary key without missing or repeated values.",
      "path": "keys/primary.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "y",
              "type": "number"
            }
          ],
          "primaryKey": [
            "id"
          ]
        }
      },
      "expected": {
        "columns": [
          {
            "name": "id",
            "type": "string",
            "values": [
              "1",
              "2"
            ]
          },
          {
            "name": "y",
            "type": "number",
            "values": [
              2.0,
              2.0
            ]
          }
        ]
      }
    },
    {
      "id": "tables-keys-002",
      "description": "A missing value in the primary key.",
      "path": "keys/primary_missing.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "y",
              "type": "number"
            }
          ],
          "primaryKey": [
            "id"
          ]
        }
      },
      "expected": {
        "issue": {
          "code": "E5008",
          "message": "The value of the column 'id' at byte 9 is missing, but the column belongs to the primary key.",
          "offset": 9
        }
      }
    },
    {
      "id": "tables-keys-003",
      "description": "A record repeats the primary key of the first record.",
