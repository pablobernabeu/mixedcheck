{
  "description": "Values in memory and their canonical bytes, or the first issue in the order of the canonical serialisation, with its JSON Pointer.",
  "cases": [
    {
      "id": "json-writer-001",
      "description": "An object with every kind of value. Only the hashable profile refuses its null.",
      "json": "{\"b\":1,\"a\":[true,false,null],\"c\":\"x\"}",
      "expected": {
        "plain": {
          "canonical": "{\"a\":[true,false,null],\"b\":1,\"c\":\"x\"}",
          "sha256": "sha256:210bd8e5501c622e789c4b9e6cd70edbfbe598f4725066bac3c1ffe0176ff0e3"
        },
        "data": {
          "canonical": "{\"a\":[true,false,null],\"b\":1,\"c\":\"x\"}",
          "sha256": "sha256:210bd8e5501c622e789c4b9e6cd70edbfbe598f4725066bac3c1ffe0176ff0e3"
        },
        "hashable": {
          "issue": {
            "code": "E1101",
            "message": "A null at /a/2 is not allowed in the hashable profile.",
            "pointer": "/a/2"
          }
        }
      }
    },
    {
      "id": "json-writer-002",
      "description": "Checks follow the canonical order of members, so the string in NFD under 'a' is reported before the null under 'b'.",
      "json": "{\"b\":null,\"a\":\"e\\u0301\"}",
      "expected": {
        "plain": {
          "canonical": "{\"a\":\"e\u0301\",\"b\":null}",
          "sha256": "sha256:7488802bae4a0292c771df0eb80070c4f70a6231daa2866404eca71bba369a74"
        },
        "data": {
          "canonical": "{\"a\":\"e\u0301\",\"b\":null}",
          "sha256": "sha256:7488802bae4a0292c771df0eb80070c4f70a6231daa2866404eca71bba369a74"
        },
        "hashable": {
          "issue": {
            "code": "E1203",
            "message": "The string at /a is not in Unicode normalisation form C (NFC).",
            "pointer": "/a"
          }
        }
      }
    },
    {
      "id": "json-writer-003",
      "description": "A key is checked before its value, at the pointer of its member.",
      "json": "{\"e\\u0301\":null}",
      "expected": {
        "plain": {
          "canonical": "{\"e\u0301\":null}",
          "sha256": "sha256:ae0979de914ebf5be1def4f43295bada0a96b48904875901c92743eedb77bce9"
        },
        "data": {
          "canonical": "{\"e\u0301\":null}",
          "sha256": "sha256:ae0979de914ebf5be1def4f43295bada0a96b48904875901c92743eedb77bce9"
        },
        "hashable": {
          "issue": {
            "code": "E1203",
            "message": "The string at /e\u0301 is not in Unicode normalisation form C (NFC).",
            "pointer": "/e\u0301"
          }
        }
      }
    },
    {
      "id": "json-writer-004",
      "description": "Members are checked in the order of UTF-16 code units, so the key U+1F600 comes before the null under U+FF08.",
      "json": "{\"\\uff08\":null,\"\\ud83d\\ude00\":1}",
      "expected": {
        "plain": {
          "canonical": "{\"\ud83d\ude00\":1,\"\uff08\":null}",
          "sha256": "sha256:e72426846090ce975ed24356c844f3f0caa592c9902427efd1bb5ba66e8d3843"
        },
        "data": {
          "issue": {
            "code": "E1108",
            "message": "The key at /\ud83d\ude00 contains a character outside the Basic Multilingual Plane.",
            "pointer": "/\ud83d\ude00"
          }
        },
        "hashable": {
          "issue": {
            "code": "E1108",
            "message": "The key at /\ud83d\ude00 contains a character outside the Basic Multilingual Plane.",
            "pointer": "/\ud83d\ude00"
          }
        }
      }
    },
    {
      "id": "json-writer-005",
      "description": "A key outside the BMP in a nested object.",
      "json": "{\"a\":{\"\\ud83d\\ude00\":1}}",
      "expected": {
        "plain": {
          "canonical": "{\"a\":{\"\ud83d\ude00\":1}}",
          "sha256": "sha256:7a59da4763fda905860d14fc058daa902ee4906b5d6bc2aa5367866ede23a110"
        },
        "data": {
          "issue": {
            "code": "E1108",
            "message": "The key at /a/\ud83d\ude00 contains a character outside the Basic Multilingual Plane.",
            "pointer": "/a/\ud83d\ude00"
          }
        },
        "hashable": {
          "issue": {
            "code": "E1108",
            "message": "The key at /a/\ud83d\ude00 contains a character outside the Basic Multilingual Plane.",
            "pointer": "/a/\ud83d\ude00"
          }
        }
      }
    },
    {
      "id": "json-writer-006",
      "description": "NaN and the infinities: the data profile writes them as strings, and the hashable profile refuses the first.",
      "json": "[1,0,0,0]",
      "substitutions": [
        {
          "pointer": "/1",
          "double": "7ff8000000000000"
        },
        {
          "pointer": "/2",
          "double": "7ff0000000000000"
        },
        {
          "pointer": "/3",
          "double": "fff0000000000000"
        }
      ],
      "expected": {
        "data": {
          "canonical": "[1,\"NaN\",\"Infinity\",\"-Infinity\"]",
          "sha256": "sha256:39f7e352cf617d83b0cfa3a2287e33a92cee45d01c99847f817014d819ac50f4"
        },
        "hashable": {
          "issue": {
            "code": "E1107",
            "message": "A non-finite number at /1 is not allowed in the hashable profile.",
            "pointer": "/1"
          }
        }
      }
    },
    {
      "id": "json-writer-007",
      "description": "NaN as a member's value beside a null.",
      "json": "{\"y\":0,\"x\":null}",
      "substitutions": [
        {
          "pointer": "/y",
          "double": "7ff8000000000000"
        }
      ],
      "expected": {
        "data": {
          "canonical": "{\"x\":null,\"y\":\"NaN\"}",
          "sha256": "sha256:845ab12a78e7c4f4282c34f2b5460152c0d76e5d39ffdd6f4623546f8a728320"
        },
        "hashable": {
          "issue": {
            "code": "E1101",
            "message": "A null at /x is not allowed in the hashable profile.",
            "pointer": "/x"
          }
        }
      }
    },
    {
      "id": "json-writer-008",
      "description": "A NaN under the key 'b' and a null under 'a': the null comes first in canonical order.",
      "json": "{\"b\":0,\"a\":null}",
      "substitutions": [
        {
          "pointer": "/b",
          "double": "7ff8000000000000"
        }
      ],
      "expected": {
        "data": {
          "canonical": "{\"a\":null,\"b\":\"NaN\"}",
          "sha256": "sha256:65ff5ce6d5b4865c65d77462901eefb254a72ab099eb466140f685dd41991145"
        },
        "hashable": {
          "issue": {
            "code": "E1101",
            "message": "A null at /a is not allowed in the hashable profile.",
            "pointer": "/a"
          }
        }
      }
    },
    {
      "id": "json-writer-009",
      "description": "Negative zero is written as 0.",
      "json": "[-0.0,-0]",
      "expected": {
        "plain": {
          "canonical": "[0,0]",
          "sha256": "sha256:3d5812abc84c11768aa73a732c85d75dbed439188f5bb3239e9b762ea31d9862"
        },
        "data": {
          "canonical": "[0,0]",
          "sha256": "sha256:3d5812abc84c11768aa73a732c85d75dbed439188f5bb3239e9b762ea31d9862"
        },
        "hashable": {
          "canonical": "[0,0]",
          "sha256": "sha256:3d5812abc84c11768aa73a732c85d75dbed439188f5bb3239e9b762ea31d9862"
        }
      }
    },
    {
      "id": "json-writer-010",
      "description": "Integral doubles are written without a fraction.",
