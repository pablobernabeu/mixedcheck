        "x": [1, 2, 3, 4, 5, 6],
        "subject": ["s1", "s1", "s1", "s2", "s2", "s2"],
        "trial": [1, 2, 3, 1, 2, 3]
      },
      "formula": "y ~ x + (1 | subject)",
      "declaration": {
        "vocabulary": "0.1.0",
        "observation": {"key": ["subject", "trial"]}
