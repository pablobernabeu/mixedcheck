{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmecheck:schema:design:0.1.0",
  "title": "lmecheck design declaration (draft 0.1.0)",
  "description": "Optional, compositional declaration of a study design, read identically by the R and Python packages. Every block is optional; a block that is present is checked against the data. Column-level typing reuses a subset of the Frictionless Table Schema v2 so that the same file can be read by Frictionless tools.",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "patternProperties": {"^x-": {}},
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "title": {"type": "string", "maxLength": 200},
    "goal": {
      "description": "Changes which checks run and how findings are graded. Absent: 'exploratory'.",
      "enum": ["confirmatory", "exploratory", "prediction"]
    },
    "features": {
      "description": "Non-exclusive design tags. Each tag requires the blocks it depends on (see allOf below). Used to select domain checks and message wording, never to change data.",
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["cluster_randomised", "multisite", "stepped_wedge", "partially_nested",
                          "longitudinal", "intensive_longitudinal", "dyadic", "family",
                          "crossed_experiment", "counterbalanced", "trial_level", "eeg", "corpus",
                          "multiple_imputation"]}
    },
    "table": {"$ref": "#/$defs/table"},
    "units": {
      "description": "Grouping units. Absent: grouping factors are taken from the formula and their relations are inferred from the data, with 'inferred' wording.",
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "crossings": {
      "description": "Pairs of units declared as crossed: a label shared across two outer units is the same unit.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["units"],
        "properties": {
          "units": {"type": "array", "items": {"$ref": "#/$defs/name"}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
          "list": {"$ref": "#/$defs/column", "description": "Counterbalancing list column, if any."}
        }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "unit": {"$ref": "#/$defs/name", "description": "The unit on which one row is observed (e.g. pupil, trial)."},
        "key": {"type": "array", "items": {"$ref": "#/$defs/column"}, "minItems": 1, "uniqueItems": true,
                "description": "Columns that identify a row. Absent: duplicate checks are informational only."},
        "time": {"$ref": "#/$defs/time"}
      }
    },
    "assignment": {
      "type": "array",
      "description": "Assigned (manipulated) variables. Absent: randomisation checks are not run.",
      "items": {"$ref": "#/$defs/assignment"}
    },
    "variables": {
      "description": "Roles of columns, keyed by column name. Absent: role checks (post-treatment adjustment, outcome leakage) are not assessable.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/column"},
      "additionalProperties": {"$ref": "#/$defs/variable"}
    },
    "estimands": {
      "type": "array",
      "description": "Focal estimands. Absent: every fixed term is treated as focal and 'consequence for a declared estimand' is not assessable.",
      "items": {"$ref": "#/$defs/estimand"}
    },
    "dyad": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "role_column", "distinguishable"],
      "properties": {
        "unit": {"$ref": "#/$defs/name"},
        "role_column": {"$ref": "#/$defs/column"},
        "distinguishable": {"type": "boolean"}
      }
    },
    "eeg": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_column", "reference"],
      "properties": {
        "channel_column": {"$ref": "#/$defs/column"},
        "reference": {"enum": ["average", "linked_mastoids", "single_electrode", "other"]},
        "time_window_column": {"$ref": "#/$defs/column"},
        "baseline_column": {"$ref": "#/$defs/column"}
      }
    },
    "imputation": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "model_accounts_for_clustering"],
      "properties": {
        "column": {"$ref": "#/$defs/column", "description": "Column that indexes imputations or plausible values."},
        "model_accounts_for_clustering": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "author": {"type": "string"},
        "outcome_seen": {"type": "boolean", "description": "Attestation, not an enforced guarantee."},
        "data_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"features": {"contains": {"const": "dyadic"}}}, "required": ["features"]},
     "then": {"required": ["dyad", "units"]}},
    {"if": {"properties": {"features": {"contains": {"const": "eeg"}}}, "required": ["features"]},
     "then": {"required": ["eeg", "observation"]}},
    {"if": {"properties": {"features": {"contains": {"enum": ["cluster_randomised", "multisite", "stepped_wedge", "partially_nested"]}}}, "required": ["features"]},
     "then": {"required": ["assignment", "units"]}},
    {"if": {"properties": {"features": {"contains": {"enum": ["longitudinal", "intensive_longitudinal", "stepped_wedge"]}}}, "required": ["features"]},
     "then": {"required": ["observation"], "properties": {"observation": {"required": ["time"]}}}},
    {"if": {"properties": {"features": {"contains": {"const": "multiple_imputation"}}}, "required": ["features"]},
     "then": {"required": ["imputation"]}},
    {"if": {"properties": {"goal": {"const": "confirmatory"}}, "required": ["goal"]},
     "then": {"required": ["units", "observation", "variables", "estimands"],
              "properties": {"observation": {"required": ["key"]}}}}
  ],
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,63}$"},
    "column": {"type": "string", "minLength": 1, "maxLength": 128},
    "unit": {
      "type": "object", "additionalProperties": false, "required": ["name", "columns"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}, "minItems": 1, "uniqueItems": true,
                    "description": "Columns whose values label the unit (usually one)."},
        "nested_in": {"$ref": "#/$defs/name"},
        "id_scope": {"enum": ["global", "within_parent"],
                     "description": "global: a label denotes the same unit wherever it appears. within_parent: labels are unique only within the parent unit, so the suite builds a collision-free composite ID."},
        "membership": {"enum": ["fixed", "may_change_over_time", "multiple"],
                       "description": "fixed (default when nested_in is given): a unit never changes parent. may_change_over_time: mobility; requires observation.time. multiple: one outcome attributed to several parents (multiple membership)."},
        "role": {"enum": ["participant", "item", "cluster", "site", "family", "dyad", "rater", "session", "trial", "channel", "other"]}
      },
      "dependentRequired": {"nested_in": ["id_scope"]}
    },
    "time": {
      "type": "object", "additionalProperties": false, "required": ["column", "kind"],
      "properties": {
        "column": {"$ref": "#/$defs/column"},
        "kind": {"enum": ["occasion", "timestamp", "trial_index", "duration_since_start"]},
        "within": {"$ref": "#/$defs/name"},
        "resolution": {"type": "string", "pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
                       "description": "ISO 8601 duration, e.g. PT1S."},
        "timezone": {"type": "string", "description": "IANA time zone of the source clock, e.g. Europe/London."}
      }
    },
    "assignment": {
      "type": "object", "additionalProperties": false, "required": ["column", "unit"],
      "properties": {
        "column": {"$ref": "#/$defs/column"},
        "unit": {"$ref": "#/$defs/name", "description": "The unit to which the variable was assigned (randomisation unit)."},
        "randomised": {"type": "boolean", "description": "Absent: true."},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true},
        "scheme": {"enum": ["simple", "complete", "blocked", "cluster", "blocked_cluster", "stepped_wedge", "crossover", "latin_square", "other"]},
        "control_level": {"type": ["string", "integer"]},
        "time_varying": {"type": "boolean", "description": "true for stepped-wedge and crossover designs: the variable may change within the unit over time."}
      }
    },
    "variable": {
      "type": "object", "additionalProperties": false, "required": ["role"],
      "properties": {
        "role": {"enum": ["outcome", "assigned", "baseline_covariate", "time_varying_covariate",
                          "post_assignment_covariate", "mediator", "outcome_derived", "time", "block",
                          "weight", "offset", "exclusion_flag", "id", "auxiliary"]},
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/column"}, "uniqueItems": true},
        "bounds": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2,
                   "description": "Declared score bounds [min, max] for ceiling and floor checks."},
        "measurement": {"enum": ["continuous", "count", "binary", "ordinal", "proportion", "response_time", "bounded_score"]}
      }
    },
    "estimand": {
      "type": "object", "additionalProperties": false, "required": ["id", "term"],
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "term": {"type": "string", "description": "A fixed-effect term in the shared formula grammar, e.g. 'arm' or 'arm:freq'."},
        "kind": {"enum": ["total_effect", "direct_effect", "association", "prediction"]},
        "contrast": {"type": "string", "description": "Optional hypothesis in canonical coefficient IDs."},
        "focal": {"type": "boolean"}
      }
    },
    "table": {
      "description": "Subset of Frictionless Table Schema v2 (fields, missingValues, primaryKey, uniqueKeys). Field descriptors may carry further Frictionless properties, which are kept but not used.",
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["name"],
            "properties": {
              "name": {"$ref": "#/$defs/column"},
              "type": {"enum": ["string", "integer", "number", "boolean", "date", "datetime", "time", "year", "duration"]},
              "categories": {"type": "array", "uniqueItems": true, "minItems": 1,
                             "items": {"oneOf": [{"type": ["string", "integer"]},
                                                 {"type": "object", "required": ["value"],
                                                  "properties": {"value": {"type": ["string", "integer"]}, "label": {"type": "string"}}}]}},
              "categoriesOrdered": {"type": "boolean"},
              "missingValues": {"$ref": "#/$defs/missingValues"}
            }
          }
        },
        "missingValues": {"$ref": "#/$defs/missingValues"},
        "primaryKey": {"type": "array", "items": {"$ref": "#/$defs/column"}, "minItems": 1},
        "uniqueKeys": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/column"}, "minItems": 1}}
      }
    },
    "missingValues": {
      "type": "array", "uniqueItems": true,
      "items": {"oneOf": [{"type": "string"},
                          {"type": "object", "required": ["value"], "additionalProperties": false,
                           "properties": {"value": {"type": "string"}, "label": {"type": "string"}}}]}
    }
  }
}
