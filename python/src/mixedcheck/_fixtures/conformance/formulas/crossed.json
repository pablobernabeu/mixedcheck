      "expected": {
        "ir": {
          "ir_version": "0.1.0",
          "predictors": {
            "cond": {
              "kind": "categorical",
              "levels": ["A", "B"],
              "levels_source": "table",
              "contrast": "treatment",
              "reference": "A"
