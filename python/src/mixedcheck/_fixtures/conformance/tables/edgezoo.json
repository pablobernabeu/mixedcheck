{
  "description": "The ten edge tables of docs/design/evidence/decisions/E-verify/edgezoo, read as stored, with their table descriptors updated to vocabulary 0.1.",
  "cases": [
    {
      "id": "tables-edgezoo-001",
      "description": "T1: without missingValues, the Frictionless default [''] applies, so the empty values of a string and a number column are missing. The row with a missing predictor leaves the design sample and the row with a missing response the analysis sample.",
      "path": "edgezoo/T1_missing_default.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "g",
              "type": "string"
            },
            {
              "name": "y",
              "type": "number"
            }
          ]
        }
      },
      "formula": "y ~ g",
      "expected": {
        "columns": [
          {
            "name": "id",
            "type": "string",
            "values": [
              "1",
              "2",
              "3"
            ]
          },
          {
            "name": "g",
            "type": "string",
            "values": [
              "a",
              null,
              "b"
            ]
          },
          {
            "name": "y",
            "type": "number",
            "values": [
              1.5,
              2.5,
              null
            ]
          }
        ],
        "design_sample": [
          0,
          2
        ],
        "analysis_sample": [
          0
        ]
      }
    },
    {
      "id": "tables-edgezoo-002",
      "description": "T2: '007' and '+5' are integers, but ' 12' is not, since nothing is trimmed, so the reader stops at it before reaching '1_000'.",
      "path": "edgezoo/T2_integer_forms.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "k",
              "type": "integer"
            }
          ],
          "missingValues": [
            ""
          ]
        }
      },
      "expected": {
        "issue": {
          "code": "E5006",
          "message": "The value ' 12' of the column 'k' at byte 18 cannot be read as an integer.",
          "offset": 18
        }
      }
    },
    {
      "id": "tables-edgezoo-003",
      "description": "T3: '0x1A' is not an integer.",
      "path": "edgezoo/T3_hex_integer.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "k",
              "type": "integer"
            }
          ],
          "missingValues": [
            ""
          ]
        }
      },
      "expected": {
        "issue": {
          "code": "E5006",
          "message": "The value '0x1A' of the column 'k' at byte 7 cannot be read as an integer.",
          "offset": 7
        }
      }
    },
    {
      "id": "tables-edgezoo-004",
      "description": "T4: NaN, INF and -INF are numbers, not missing values, so no row leaves either sample. Building the response vector later gives E6073 (ir.md).",
      "path": "edgezoo/T4_number_tokens.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "y",
              "type": "number"
            }
          ],
          "missingValues": [
            ""
          ]
        }
      },
      "formula": "y ~ 1",
      "expected": {
        "columns": [
          {
            "name": "id",
            "type": "string",
            "values": [
              "1",
              "2",
              "3"
            ]
          },
          {
            "name": "y",
            "type": "number",
            "values": [
              "NaN",
              "Infinity",
              "-Infinity"
            ]
          }
        ],
        "design_sample": [
          0,
          1,
          2
        ],
        "analysis_sample": [
          0,
          1,
          2
        ]
      }
    },
    {
      "id": "tables-edgezoo-005",
      "description": "T5: 'NA' is a string value, not a missing value, and white space and a quoted comma are kept, so every row stays in the analysis sample of a formula whose response is the string column.",
