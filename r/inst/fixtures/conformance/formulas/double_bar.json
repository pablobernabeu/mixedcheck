{
  "description": "'||' on numeric terms and on factors whose coding is frozen as numeric contrast columns, its rejection on other categorical columns and its interplay with '/' and centring.",
  "cases": [
    {
      "id": "double-bar-01",
      "description": "'||' splits a numeric slope from the intercept.",
      "formula": "y ~ x + (x || g)",
      "data": {
        "y": [1.5, 2.25, 3, 2.5, 4, 3.5, 1, 2, 2.75, 3.25, 4.5, 0.5],
        "x": [1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6],
        "g": ["g1", "g1", "g1", "g2", "g2", "g2", "g3", "g3", "g3", "g4", "g4", "g4"]
      },
      "expected": {
        "ir": {
          "ir_version": "0.1.0",
          "predictors": {"x": {"kind": "numeric", "centring": {"rule": "none"}}},
          "fixed": {
            "terms": [
              {"name": "(Intercept)", "variables": []},
              {"name": "x", "variables": [{"variable": "x"}]}
            ],
            "columns": [
              {"name": "(Intercept)", "term": 0, "levels": {}},
              {"name": "x", "term": 1, "levels": {}}
            ]
          },
          "random": [
            {
              "name": "1 | g",
              "factor": "g",
              "grouping": ["g"],
              "covariance": "unstructured",
              "terms": [{"name": "(Intercept)", "variables": []}],
              "columns": [{"name": "(Intercept)", "term": 0, "levels": {}}]
            },
            {
              "name": "0 + x | g",
              "factor": "g",
              "grouping": ["g"],
              "covariance": "unstructured",
              "terms": [{"name": "x", "variables": [{"variable": "x"}]}],
              "columns": [{"name": "x", "term": 0, "levels": {}}]
            }
          ],
          "offsets": [],
          "response": {"variable": "y", "transform": "identity"}
        },
        "ir_hash": "sha256:4309a2fe50a3c0c197e71127062b0489810f3a604b540b85846a4934a7f05c24"
      }
    },
