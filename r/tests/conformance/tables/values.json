{
  "description": "Declared columns: missing values, the lexical form of each field type (E5006) and categories (E5007).",
  "cases": [
    {
      "id": "tables-values-001",
      "description": "A field's missingValues replace the table's, which replace the default, so '' and 'NA' are values of 's' and only '-99' is missing.",
      "path": "values/field_missing_values.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "s",
              "type": "string",
              "missingValues": [
                "-99"
              ]
            },
            {
              "name": "t",
              "type": "string"
            }
          ],
          "missingValues": [
            "NA",
            ""
          ]
        }
      },
      "expected": {
        "columns": [
          {
            "name": "id",
            "type": "string",
            "values": [
              "1",
              "2",
              "3"
            ]
          },
          {
            "name": "s",
            "type": "string",
            "values": [
              "NA",
              null,
              ""
            ]
          },
          {
            "name": "t",
            "type": "string",
            "values": [
              null,
              "-99",
              null
            ]
          }
        ]
      }
    },
    {
      "id": "tables-values-002",
      "description": "A labelled sentinel code of an integer field is missing, and another negative code is a value.",
      "path": "values/labelled_sentinel.csv",
      "declaration": {
        "vocabulary": "0.1.0",
        "table": {
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "k",
              "type": "integer",
              "missingValues": [
                {
                  "value": "-99",
                  "label": "refused"
                }
              ]
            }
          ]
        }
      },
      "expected": {
        "columns": [
          {
            "name": "id",
            "type": "string",
            "values": [
              "1",
              "2",
              "3"
            ]
          },
          {
            "name": "k",
            "type": "integer",
            "values": [
              null,
              -98,
              4
            ]
          }
        ]
      }
    },
